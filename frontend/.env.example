# Public browser configuration only. Never put cloud credentials in VITE_* variables.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8123
# Optional: defaults to the current page origin and uses /api/ws through Vite.
VITE_WS_BASE_URL=
# Optional: your own image origin, used only for the development image proxy.
VITE_IMAGE_ORIGIN=
