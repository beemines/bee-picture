# Optional local overrides. Copy to application-local.yml and use the local profile.
# This file contains placeholders only; never commit real credentials.
spring:
  datasource:
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:}
cos:
  client:
    host: ${COS_HOST:}
    secretId: ${COS_SECRET_ID:}
    secretKey: ${COS_SECRET_KEY:}
    region: ${COS_REGION:ap-guangzhou}
    bucket: ${COS_BUCKET:}
aliYunAi:
  apiKey: ${ALIYUN_AI_API_KEY:}
